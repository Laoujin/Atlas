                                                    <script type="text/javascript" language="javascript">coded = "enabjeb@f2kJgjb2joE.en0" 
		cipher = "kMxhm9fPyLWDbern6p7HSKzwYE30RVXu81d42gasJO5FGlNCUvAtcQoZqBITij" 
